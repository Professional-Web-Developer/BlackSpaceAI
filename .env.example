# ---- Model provider (required) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model every agent uses unless its profile pins one. Change it here to roll a
# new model out everywhere without touching code - useful for running a cheaper
# model in staging. Defaults to claude-opus-5 when unset.
ANTHROPIC_MODEL=claude-opus-5

# On startup the app asks the Anthropic Models API whether the configured
# models exist, so a typo fails the boot instead of every chat request. Set
# this to "true" to skip that check - useful offline or in CI. It is skipped
# automatically during `next build` and when no API key is set.
SKIP_MODEL_VALIDATION=false

# ---- Accounts (required once auth is in place) ----
# Addresses that get the admin role when they register. Admins are the only
# accounts that can ingest or delete knowledge base documents. Comma separated.
# Naming them here rather than promoting in-app means the first person to sign
# up cannot make themselves one.
ADMIN_EMAILS=you@example.com

# Monthly spend cap per user, in US dollars, for accounts with no override.
# Admins can set a different limit per user. Set to 0 to disable the cap -
# spending is still recorded, it is just never refused.
DEFAULT_MONTHLY_LIMIT_USD=20

# ---- Attachments on S3 (optional) ----
# Files upload straight from the browser to S3 with a presigned PUT, so bytes
# never pass through this server. Without a bucket the attach control is hidden.
AWS_REGION=us-east-1
S3_BUCKET=blackspace-attachments
# Omit both keys to use the default credential chain (IAM role, shared profile,
# web identity) - preferred on AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For S3-compatible stores: Cloudflare R2, MinIO, or a local test server.
# S3_ENDPOINT=
MAX_UPLOAD_MB=25

# ---- Retrieval / RAG (optional) ----
# Anthropic has no embedding model, so this is the one pluggable provider.
# Leave the key unset and retrieval is simply unavailable; nothing else changes.
# Leave EMBEDDING_PROVIDER and EMBEDDING_MODEL unset and setting one key is the
# whole configuration - the provider is detected from whichever key is present,
# and each has its own default model. Set them explicitly only when more than
# one key exists.
#
# Google's free tier (AI Studio, no card) is the no-cost option:
GOOGLE_GENERATIVE_AI_API_KEY=...
# VOYAGE_API_KEY=pa-...             # Anthropic's recommended partner
# OPENAI_API_KEY=sk-...
# EMBEDDING_PROVIDER=google         # voyage | openai | google
# EMBEDDING_MODEL=                  # defaults per provider
# EMBEDDING_BASE_URL=                # override for a gateway or regional endpoint

# Similarity floor below which a passage counts as "not found". THIS MUST BE
# CALIBRATED for your embedding model - see the README. The default suits
# voyage-3.5; a wrong value either floods answers with noise or rejects every
# real match.
RAG_MIN_SIMILARITY=0.35
RAG_MAX_RESULTS=6

# ---- Langfuse observability (optional; tracing is skipped if unset) ----
# https://cloud.langfuse.com -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: tag traces by deployment environment (default: "development")
LANGFUSE_TRACING_ENVIRONMENT=development
