# ---- Model provider (required) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model every agent uses unless its profile pins one. Change it here to roll a
# new model out everywhere without touching code - useful for running a cheaper
# model in staging. Defaults to claude-opus-5 when unset.
ANTHROPIC_MODEL=claude-opus-5

# On startup the app asks the Anthropic Models API whether the configured
# models exist, so a typo fails the boot instead of every chat request. Set
# this to "true" to skip that check - useful offline or in CI. It is skipped
# automatically during `next build` and when no API key is set.
SKIP_MODEL_VALIDATION=false

# ---- Retrieval / RAG (optional) ----
# Anthropic has no embedding model, so this is the one pluggable provider.
# Leave the key unset and retrieval is simply unavailable; nothing else changes.
EMBEDDING_PROVIDER=voyage            # voyage | openai
EMBEDDING_MODEL=voyage-3.5           # openai alternative: text-embedding-3-small
VOYAGE_API_KEY=pa-...
# OPENAI_API_KEY=sk-...
# EMBEDDING_BASE_URL=                # override for a gateway or regional endpoint

# Similarity floor below which a passage counts as "not found". THIS MUST BE
# CALIBRATED for your embedding model - see the README. The default suits
# voyage-3.5; a wrong value either floods answers with noise or rejects every
# real match.
RAG_MIN_SIMILARITY=0.35
RAG_MAX_RESULTS=6

# ---- Langfuse observability (optional; tracing is skipped if unset) ----
# https://cloud.langfuse.com -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: tag traces by deployment environment (default: "development")
LANGFUSE_TRACING_ENVIRONMENT=development
