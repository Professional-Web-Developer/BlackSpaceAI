# ---- Model provider (required) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model every agent uses unless its profile pins one. Change it here to roll a
# new model out everywhere without touching code - useful for running a cheaper
# model in staging. Defaults to claude-opus-5 when unset.
ANTHROPIC_MODEL=claude-opus-5

# ---- Langfuse observability (optional; tracing is skipped if unset) ----
# https://cloud.langfuse.com -> Project Settings -> API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region: https://cloud.langfuse.com  |  US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: tag traces by deployment environment (default: "development")
LANGFUSE_TRACING_ENVIRONMENT=development
